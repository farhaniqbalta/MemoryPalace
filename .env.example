DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/memorypalace
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID. Leave unset until configuring bot access.
# TELEGRAM_OWNER_ID=123456789

CLAUDE_MODEL=claude-haiku-5-5
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional explicit override; normally leave unset so provider selects its model.
# EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

API_BASE_URL=http://localhost:8000
