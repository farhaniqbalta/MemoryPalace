DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/memorypalace
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=

# Model used for extraction and Q&A. Defaults to the most capable Claude
# model; swap to claude-sonnet-5 or claude-haiku-4-5 to cut cost.
CLAUDE_MODEL=claude-opus-5

# OpenAI embedding model. Dimension must match the `embedding` column in
# app/models.py if you change this.
EMBEDDING_MODEL=text-embedding-3-small

API_BASE_URL=http://localhost:8000
